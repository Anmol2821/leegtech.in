# Private lead tracker: never cache or index, no framing, no scripts.
DirectoryIndex index.php
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow"
Header always set Cache-Control "no-store"
Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; form-action 'self' https://wa.me; frame-ancestors 'none'; base-uri 'none'"
</IfModule>
